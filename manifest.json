{
  "manifest_version": 3,
  "name": "Leo Reader",
  "version": "0.1.0",
  "description": "Đọc bài viết và văn bản được chọn bằng giọng nói trên trình duyệt.",
  "minimum_chrome_version": "116",
  "permissions": ["activeTab", "scripting", "storage", "sidePanel", "tts", "contextMenus"],
  "host_permissions": ["https://*.webnovel.vn/*", "http://127.0.0.1:17843/*"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "side_panel": { "default_path": "reader.html" },
  "web_accessible_resources": [{
    "resources": ["reader.html"],
    "matches": ["http://*/*", "https://*/*"]
  }],
  "action": {
    "default_title": "Mở chế độ đọc",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  }
}
